<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.github.mayconr.shard.storage.MobileMapper">

    <!-- =========================
         ResultMaps
         ========================= -->

    <resultMap id="MobileDataMap" type="com.github.mayconr.juoserver.game.model.UOMobileData">

        <!-- Base -->
        <id property="serialId" column="serial_id"/>
        <result property="modelId" column="model_id"/>

        <result property="x" column="x"/>
        <result property="y" column="y"/>
        <result property="z" column="z"/>

        <result property="name" column="name"/>
        <result property="displayName" column="display_name"/>

        <result property="persistentAttrMap"
                column="runtime_attr"
                typeHandler="com.github.mayconr.shard.storage.types.AttributesTypeHandler"/>

        <!-- Estado -->
        <result property="hue" column="hue"/>

        <result property="race"
                column="race"
                typeHandler="com.github.mayconr.shard.storage.types.RaceTypeHandler"/>

        <result property="gender"
                column="gender"
                typeHandler="com.github.mayconr.shard.storage.types.GenderTypeHandler"/>

        <result property="notoriety"
                column="notoriety"
                typeHandler="com.github.mayconr.shard.storage.types.NotorietyTypeHandler"/>

        <result property="status"
                column="status"
                typeHandler="com.github.mayconr.shard.storage.types.CharacterStatusTypeHandler"/>

        <result property="direction"
                column="direction"
                typeHandler="com.github.mayconr.shard.storage.types.DirectionTypeHandler"/>

        <result property="running" column="running"/>

        <!-- Vitals -->
        <result property="hitpoints" column="hitpoints"/>
        <result property="maxHitpoints" column="max_hitpoints"/>

        <result property="stamina" column="stamina"/>
        <result property="maxStamina" column="max_stamina"/>

        <result property="mana" column="mana"/>
        <result property="maxMana" column="max_mana"/>

        <result property="alive" column="alive"/>

        <!-- Stats -->
        <result property="strength" column="strength"/>
        <result property="dexterity" column="dexterity"/>
        <result property="intelligence" column="intelligence"/>

        <result property="statCap" column="stat_cap"/>

        <result property="followers" column="followers"/>
        <result property="maxFollowers" column="max_followers"/>

        <!-- Misc -->
        <result property="luck" column="luck"/>
        <result property="tithingPoints" column="tithing_points"/>

        <!-- Tipo -->
        <result property="type" column="type"/>

        <!-- Player -->
        <result property="accountId"
                column="account_id"
                typeHandler="com.github.mayconr.shard.storage.types.UUIDTypeHandler"/>

        <!-- NPC -->
        <result property="roles"
                column="roles"
                typeHandler="com.github.mayconr.shard.storage.types.RolesJsonTypeHandler"/>

        <result property="behavior"
                column="behavior"
                     javaType="com.github.mayconr.juoserver.game.model.BehaviorDefinition"
                     typeHandler="com.github.mayconr.shard.storage.types.BehaviorDefinitionTypeHandler" />

    </resultMap>


    <resultMap id="SkillValueMap" type="com.github.mayconr.juoserver.game.model.SkillValue">
        <constructor>
            <arg column="skill_id"   javaType="int"/>
            <arg column="skill_base" javaType="double"/>
            <arg column="skill_cap"  javaType="double"/>
            <arg column="skill_lock"
                 javaType="com.github.mayconr.juoserver.game.model.SkillLock"
                 typeHandler="com.github.mayconr.shard.storage.types.SkillLockTypeHandler"/>
        </constructor>
    </resultMap>


    <!-- =========================
         Serial counter
         ========================= -->

    <select id="findNextMobileSerial" resultType="int">
        SELECT next_serial
        FROM serial_counters
        WHERE entity_type = 'MOBILE'
    </select>

    <update id="updateMobileSerial">
        UPDATE serial_counters
        SET next_serial = #{serial},
        updated_at  = NOW()
        WHERE entity_type = 'MOBILE'
    </update>


    <!-- =========================
         Queries
         ========================= -->

    <select id="mobileExists" resultType="boolean">
        SELECT EXISTS (
        SELECT 1
        FROM mobiles
        WHERE LOWER(name) = LOWER(#{name})
        )
    </select>

    <select id="findMobileBySerialId" resultMap="MobileDataMap">
        SELECT *
        FROM mobiles
        WHERE serial_id = #{serialId}
    </select>

    <select id="findAllNpcs" resultMap="MobileDataMap">
        SELECT *
        FROM mobiles
        WHERE type = 'N'
    </select>

    <select id="findSkillsBySerialId" resultMap="SkillValueMap">
        SELECT *
        FROM mobile_skills
        WHERE serial_id = #{serialId}
    </select>


    <!-- =========================
         Upsert Mobile (tabela única)
         ========================= -->

    <insert id="upsertMobile">

        INSERT INTO mobiles (
        serial_id,
        type,
        name,
        display_name,
        model_id,
        hue,
        race,
        gender,
        notoriety,
        status,
        account_id,
        roles,
        behavior,
        strength,
        dexterity,
        intelligence,
        stat_cap,
        followers,
        max_followers,
        luck,
        tithing_points,
        max_hitpoints,
        max_stamina,
        max_mana,
        x,
        y,
        z,
        direction,
        running,
        hitpoints,
        stamina,
        mana,
        alive,
        runtime_attr
        )
        VALUES (
        #{serialId},
        #{type},
        #{name},
        #{displayName},
        #{modelId},
        #{hue},
        #{race},
        #{gender},
        #{notoriety},
        #{status},
        #{accountId},
        #{roles, typeHandler=com.github.mayconr.shard.storage.types.RolesJsonTypeHandler}::jsonb,
        #{behavior, typeHandler=com.github.mayconr.shard.storage.types.BehaviorDefinitionTypeHandler}::jsonb,
        #{strength},
        #{dexterity},
        #{intelligence},
        #{statCap},
        #{followers},
        #{maxFollowers},
        #{luck},
        #{tithingPoints},
        #{maxHitpoints},
        #{maxStamina},
        #{maxMana},
        #{x},
        #{y},
        #{z},
        #{direction},
        #{running},
        #{hitpoints},
        #{stamina},
        #{mana},
        #{alive},
        #{persistentAttrMap, typeHandler=com.github.mayconr.shard.storage.types.AttributesTypeHandler}::jsonb
        )

        ON CONFLICT (serial_id)
        DO UPDATE SET
        type               = EXCLUDED.type,
        name               = EXCLUDED.name,
        display_name       = EXCLUDED.display_name,
        model_id           = EXCLUDED.model_id,
        hue                = EXCLUDED.hue,
        race               = EXCLUDED.race,
        gender             = EXCLUDED.gender,
        notoriety          = EXCLUDED.notoriety,
        status             = EXCLUDED.status,
        account_id         = EXCLUDED.account_id,
        roles              = EXCLUDED.roles,
        strength           = EXCLUDED.strength,
        dexterity          = EXCLUDED.dexterity,
        intelligence       = EXCLUDED.intelligence,
        stat_cap           = EXCLUDED.stat_cap,
        followers          = EXCLUDED.followers,
        max_followers      = EXCLUDED.max_followers,
        luck               = EXCLUDED.luck,
        tithing_points     = EXCLUDED.tithing_points,
        max_hitpoints      = EXCLUDED.max_hitpoints,
        max_stamina        = EXCLUDED.max_stamina,
        max_mana           = EXCLUDED.max_mana,
        x                  = EXCLUDED.x,
        y                  = EXCLUDED.y,
        z                  = EXCLUDED.z,
        direction          = EXCLUDED.direction,
        running            = EXCLUDED.running,
        hitpoints          = EXCLUDED.hitpoints,
        stamina            = EXCLUDED.stamina,
        mana               = EXCLUDED.mana,
        alive              = EXCLUDED.alive,
        runtime_attr       = EXCLUDED.runtime_attr,
        updated_at         = NOW()

    </insert>


    <!-- =========================
         Skills
         ========================= -->

    <insert id="upsertSkill">
        INSERT INTO mobile_skills (
        serial_id,
        skill_id,
        skill_base,
        skill_cap,
        skill_lock
        )
        VALUES (
        #{serialId},
        #{skill.skillId},
        #{skill.base},
        #{skill.cap},
        #{skill.lock}
        )
        ON CONFLICT (serial_id, skill_id)
        DO UPDATE SET
        skill_base = EXCLUDED.skill_base,
        skill_cap  = EXCLUDED.skill_cap,
        skill_lock = EXCLUDED.skill_lock
    </insert>


    <!-- =========================
         Delete
         ========================= -->

    <delete id="deleteBySerialId">
        DELETE FROM mobiles
        WHERE serial_id = #{serialId}
    </delete>

</mapper>