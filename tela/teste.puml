@startuml
title Arquitetura inicial - Consulta com cache de documentos e nomes

skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

actor "BFF Tela" as BFF

rectangle "Serviço de Cache / Consulta" as CACHE_SERVICE {
  component "API de Consulta" as QUERY_API
  component "Orquestrador de\nEnriquecimento" as ORCHESTRATOR
  component "Cache Redis" as REDIS
}

database "Base Documentos" as DOC_DB
database "Base Nome" as NAME_DB

BFF --> QUERY_API : consulta(cnpj, filtros)
QUERY_API --> ORCHESTRATOR : processar consulta

ORCHESTRATOR --> DOC_DB : buscar CPFs por CNPJ\nou vínculos documento
ORCHESTRATOR --> REDIS : buscar nome por CPF\n/ razão social por CNPJ

REDIS --> ORCHESTRATOR : hits de cache

ORCHESTRATOR --> NAME_DB : buscar faltantes\n(cpf->nome, cnpj->razão social)
NAME_DB --> ORCHESTRATOR : dados faltantes

ORCHESTRATOR --> REDIS : preencher/atualizar cache

ORCHESTRATOR --> QUERY_API : resultado unificado
QUERY_API --> BFF : resposta paginada/filtrada

@enduml